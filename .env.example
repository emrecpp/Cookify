# Public OAuth client IDs of the published Cookify extension (they are not secrets: Google only accepts them from
# the published extension ID). Copy this file to .env.development or .env.production. A build with a different
# extension ID needs its own client IDs; see "Google Drive OAuth setup" in README.md.

# Chrome extension OAuth 2.0 client ID created in Google Cloud Console.
VITE_GOOGLE_OAUTH_CLIENT_ID=5825528778-7i6puto62js7j1gj7qn10vnucu95kgl2.apps.googleusercontent.com

# Web application OAuth client for the "Use another Google account" chooser.
VITE_GOOGLE_OAUTH_WEB_CLIENT_ID=5825528778-pcv0mkv3lkt5aaiadr6696r36tn7bf26.apps.googleusercontent.com
