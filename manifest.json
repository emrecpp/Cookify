{
    "manifest_version": 3,
    "name": "Cookify - Swagger UI API Client, JWT & Cookie Manager",
    "description": "Postman-like API client for any Swagger UI page. Dark mode, tabs, environments, JWT and cookie manager. No import, no setup.",
    "version": "2.0.5",
    "homepage_url": "https://github.com/emrecpp/Cookify",
    "permissions": [
        "cookies",
        "storage",
        "unlimitedStorage",
        "alarms",
        "scripting",
        "activeTab",
        "identity",
        "identity.email"
    ],
    "oauth2": {
        "client_id": "000000000000-setup-cookify.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata",
            "openid",
            "email",
            "profile"
        ]
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icon/16.png",
        "32": "icon/32.png",
        "48": "icon/48.png",
        "96": "icon/96.png",
        "128": "icon/128.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icon/16.png",
            "32": "icon/32.png",
            "48": "icon/48.png",
            "96": "icon/96.png",
            "128": "icon/128.png"
        }
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "swagger-preload.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "/src/runtime/router.ts"
            ]
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content-script/src/main.tsx"
            ],
            "run_at": "document_end"
        }
    ]
}
